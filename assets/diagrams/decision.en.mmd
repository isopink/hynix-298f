flowchart TB
    S["Scheduled run · every 15 min, 09:30 – 15:15"] --> P["Intraday re-screen · code<br/>Kiwoom ranks → candidates, live RSI"]
    P --> RT["Routing · code<br/>only candidates that changed since the last run<br/>(price ±1.5%, flow flip, new news) go to debate"]
    RT --> G["Regime<br/>market regime → exposure cap"]
    RT --> PO["Position manager<br/>holdings: sell / hold / add"]
    RT --> RS["Research<br/>fact sheet: news, filings, sector, overseas"]
    RS --> B["Bull<br/>case for, from the fact sheet"]
    B --> R["Bear<br/>case against + rebuttal, same facts"]
    G --> V
    PO --> V
    R --> V["Claim check · code<br/>every number must exist in the briefing"]
    V --> L["Lead agent<br/>final conviction and action"]
    L --> C["Code adjusts conviction<br/>bear market · RSI → sizing"]
    C --> E["Executor<br/>sells first, then buys, then records"]
    E --> H{{"Risk Hook<br/>before every order"}}
    H -- pass --> O["Kiwoom order"]
    H -- violation --> X["Blocked + logged"]
    classDef agent fill:#1c1416,stroke:#ff5a65,color:#f2f2f2
    classDef code fill:#1a1a1a,stroke:#6a6a6a,color:#e6e6e6
    classDef hook fill:#2a1416,stroke:#ff7a82,stroke-width:2px,color:#ffffff
    classDef ok fill:#121a26,stroke:#4e94ff,color:#f2f2f2
    class G,PO,RS,B,R,L,E agent
    class P,RT,V,C code
    class H,X hook
    class O ok
