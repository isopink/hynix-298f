flowchart TB
    S["정기 판단 · 09:30 ~ 15:15 15분마다"] --> P["장중 후보 재선별 · 코드<br/>키움 순위 → 후보, 장중 RSI"]
    P --> RT["토론 라우팅 · 코드<br/>직전 회차보다 달라진 후보만 토론<br/>가격 ±1.5% · 수급 방향 · 새 뉴스"]
    RT --> G["국면<br/>Sonnet · high"]
    RT --> PO["보유 관리<br/>보유 종목 매도 · 보유 · 추가 매수<br/>Opus · high"]
    RT --> RS["근거 수집<br/>뉴스 · 공시 · 업종 · 해외 사실 표<br/>Opus · xhigh"]
    RS --> B["매수 측<br/>사실 표로 강세 근거<br/>Opus · high"]
    B --> R["매도 측<br/>같은 사실 표로 약세 근거 · 반박<br/>Opus · high"]
    G --> V
    PO --> V
    R --> V["근거 숫자 대조 · 코드<br/>브리핑에 없는 숫자는 근거에서 뺌"]
    V --> L["총괄<br/>최종 확신도 · 행동<br/>Opus · xhigh"]
    L --> C["코드가 확신도 보정<br/>하락 국면 · RSI → 수량 계산"]
    C --> E["주문 실행<br/>매도 먼저 → 매수 → 기록<br/>Haiku"]
    E --> H{{"리스크 Hook<br/>주문마다 검사"}}
    H -- 통과 --> O["키움 주문"]
    H -- 위반 --> X["차단 + 기록"]
    classDef agent fill:#1c1416,stroke:#ff5a65,color:#f2f2f2
    classDef code fill:#1a1a1a,stroke:#6a6a6a,color:#e6e6e6
    classDef hook fill:#2a1416,stroke:#ff7a82,stroke-width:2px,color:#ffffff
    classDef ok fill:#121a26,stroke:#4e94ff,color:#f2f2f2
    class G,PO,RS,B,R,L,E agent
    class P,RT,V,C code
    class H,X hook
    class O ok
