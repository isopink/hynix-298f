flowchart TB
    subgraph DATA["① Data · Python"]
        D1["08:30 prep<br/>KRX prices · 5-day flows<br/>Naver news"]
        D2["Before every decision<br/>Kiwoom intraday ranks · live RSI<br/>routing: what changed"]
    end
    subgraph AGENT["② Decide · Claude Code sub-agents"]
        A1["Regime · Position · Research<br/>in parallel"]
        A2["Bull ⇄ Bear<br/>on one shared fact sheet"]
        A3["Lead agent<br/>conviction 0–1"]
        A4["Executor"]
        A1 --> A2 --> A3 --> A4
    end
    subgraph RULES["③ Rules · code"]
        R1["Claim check · conviction adjustments<br/>RSI · falling market"]
        R2["Sizing<br/>qty · stop · target"]
        R3{{"Risk Hook"}}
        R1 --> R2 --> R3
    end
    K["Kiwoom REST API<br/>(own MCP server)"]
    LOG[("journal.jsonl")]
    WEB["Dashboard"]

    DATA --> AGENT
    A3 -.-> R1
    A4 --> R3
    R3 -- pass --> K
    R3 -- block --> LOG
    K --> LOG --> WEB
    LOG -. "16:00 scorer → tuner<br/>Wed · Fri review → writer" .-> AGENT
    classDef agent fill:#1c1416,stroke:#ff5a65,color:#f2f2f2
    classDef hook fill:#2a1416,stroke:#ff7a82,stroke-width:2px,color:#ffffff
    classDef ok fill:#121a26,stroke:#4e94ff,color:#f2f2f2
    class A1,A2,A3,A4 agent
    class R3 hook
    class K ok
