# 이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채우세요. (.env 는 GitHub에 올라가지 않음)
# 키움 App Key / Secret 은 여기가 아니라 live/.env 하나에만 둡니다 (잔고 스크립트와 같이 씀).

MODE=mock                 # mock = 가상 계좌로 연습 / live = 키움 모의투자 서버로 실제 주문

KRX_ID=                   # KRX 정보데이터시스템 계정 (전 종목 시세·투자자별 매매·지수 조회에 필요)
KRX_PW=
NAVER_CLIENT_ID=          # developers.naver.com 애플리케이션 등록 → 검색 API (없으면 뉴스를 건너뜀)
NAVER_CLIENT_SECRET=

GIT_PUSH=0                # 1 = 실행이 끝날 때마다 docs/data 를 커밋·푸시해서 대시보드 갱신
