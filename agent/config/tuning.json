    "decision.stop_loss_pct":       { "label": "손절선",             "min": -0.10, "max": -0.04, "step": 0.01 },
    "decision.take_profit_pct":     { "label": "익절선",             "min": 0.06, "max": 0.25, "step": 0.03 },
