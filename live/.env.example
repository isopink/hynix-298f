# 이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채우세요. (.env 는 GitHub에 올라가지 않음)
# 팀 계좌 키를 가진 사람 1명의 PC에서만 실행하면 됩니다.

ACCOUNT_NAME=팀                     # 팀 계좌 이름 (그대로 두면 됨)
KIWOOM_APPKEY=
KIWOOM_SECRETKEY=
KIWOOM_BASE=https://mockapi.kiwoom.com   # 모의투자 서버

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SNAPSHOT_SECRET=여기에-긴-비밀문구-입력    # schema.sql 마지막 줄과 똑같이

INTERVAL_SEC=300                    # 조회 간격 (초). 300 = 5분
